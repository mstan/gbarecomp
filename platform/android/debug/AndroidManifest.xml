<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build overlay. Android requires INTERNET even for the loopback socket
  the runtime's observe-mode debug TCP server listens on (reached through
  `adb forward`). Release builds do not request network access.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
